### RULES ###

### tuple ### allow tcp 22 ::/0 any ::/0 OpenSSH - in
-A ufw6-user-input -p tcp --dport 22 -j ACCEPT -m comment --comment 'dapp_OpenSSH'

### tuple ### allow tcp 80 ::/0 any ::/0 in
-A ufw6-user-input -p tcp --dport 80 -j ACCEPT

### tuple ### route:allow any any ::/0 any ::/0 in_wg0!out_wlo1
-A ufw6-user-forward -i wg0 -o wlo1 -j ACCEPT

### tuple ### allow tcp 443 ::/0 any ::/0 in
-A ufw6-user-input -p tcp --dport 443 -j ACCEPT

### tuple ### allow tcp 53 ::/0 any ::/0 in
-A ufw6-user-input -p tcp --dport 53 -j ACCEPT

### tuple ### allow udp 53 ::/0 any ::/0 in
-A ufw6-user-input -p udp --dport 53 -j ACCEPT

### tuple ### deny any 8096 ::/0 any ::/0 in comment=44656e79204a656c6c7966696e20746f20616e797468696e6720656c7365
-A ufw6-user-input -p tcp --dport 8096 -j DROP
-A ufw6-user-input -p udp --dport 8096 -j DROP

### tuple ### deny any 8080 ::/0 any ::/0 in comment=44656e792071426974546f7272656e7420746f20616e797468696e6720656c7365
-A ufw6-user-input -p tcp --dport 8080 -j DROP
-A ufw6-user-input -p udp --dport 8080 -j DROP

### tuple ### deny any 139 ::/0 any ::/0 in
-A ufw6-user-input -p tcp --dport 139 -j DROP
-A ufw6-user-input -p udp --dport 139 -j DROP

### tuple ### allow any 1515 ::/0 any ::/0 in
-A ufw6-user-input -p tcp --dport 1515 -j ACCEPT
-A ufw6-user-input -p udp --dport 1515 -j ACCEPT

### tuple ### allow any 1514 ::/0 any ::/0 in
-A ufw6-user-input -p tcp --dport 1514 -j ACCEPT
-A ufw6-user-input -p udp --dport 1514 -j ACCEPT

### END RULES ###

### LOGGING ###
-A ufw6-after-logging-input -j LOG --log-prefix "[UFW BLOCK] " -m limit --limit 3/min --limit-burst 10
-A ufw6-after-logging-forward -j LOG --log-prefix "[UFW BLOCK] " -m limit --limit 3/min --limit-burst 10
-I ufw6-logging-deny -m conntrack --ctstate INVALID -j RETURN -m limit --limit 3/min --limit-burst 10
-A ufw6-logging-deny -j LOG --log-prefix "[UFW BLOCK] " -m limit --limit 3/min --limit-burst 10
-A ufw6-logging-allow -j LOG --log-prefix "[UFW ALLOW] " -m limit --limit 3/min --limit-burst 10
### END LOGGING ###

### RATE LIMITING ###
-A ufw6-user-limit -m limit --limit 3/minute -j LOG --log-prefix "[UFW LIMIT BLOCK] "
-A ufw6-user-limit -j REJECT
-A ufw6-user-limit-accept -j ACCEPT
### END RATE LIMITING ###
